# production build-ის (npm run build) API მისამართი. NEXT_PUBLIC_* build-ის დროს ჩაიწერება კოდში.
# ლოკალური (next dev) მისამართი .env.development.local-შია.
NEXT_PUBLIC_API_URL='https://flyinspectors.com/api'

# Meta პიქსელი. სერვერზე იგივე ნომერია (server/.env → META_PIXEL_ID).
NEXT_PUBLIC_META_PIXEL_ID='1400277778859172'
