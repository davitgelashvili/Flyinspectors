3:["$","section",null,{"className":"OptionsSection_OptionsSection__MXuNI","children":["$","div",null,{"className":"container OptionsSection_OptionsSection__inner__Hsd8r","children":[["$","h2",null,{"className":"OptionsSection_title__NbpVp","children":"DO YOU QUALIFY FOR A COMPENSATION?"}],["$","div",null,{"className":"OptionsSection_grid__UKjHu","children":[["$","div",null,{"className":"OptionsSection_item__ikj3v","children":[["$","div",null,{"className":"OptionsSection_item__bar__Vyym5"}],["$","h3",null,{"className":"OptionsSection_item__title__Z3ctV","children":"Flight Delay Compensation"}],["$","p",null,{"className":"OptionsSection_item__desc__kzStL","children":"If your flight is delayed by 3+ hours, according to EU regulations, you are entitled to compensation in the amount of 250-600 euros."}]]}],["$","div",null,{"className":"OptionsSection_item__ikj3v","children":[["$","div",null,{"className":"OptionsSection_item__bar__Vyym5"}],["$","h3",null,{"className":"OptionsSection_item__title__Z3ctV","children":"Flight Cancellation Compensation"}],["$","p",null,{"className":"OptionsSection_item__desc__kzStL","children":"Your flight was delayed and you didn't receive at least 14 days' notice? You're entitled to compensation."}]]}],["$","div",null,{"className":"OptionsSection_item__ikj3v","children":[["$","div",null,{"className":"OptionsSection_item__bar__Vyym5"}],["$","h3",null,{"className":"OptionsSection_item__title__Z3ctV","children":"Missed Connection Compensation"}],["$","p",null,{"className":"OptionsSection_item__desc__kzStL","children":"Missed your connecting flight due to a flight delay? You may be entitled to flight compensation."}]]}],["$","div",null,{"className":"OptionsSection_item__ikj3v","children":[["$","div",null,{"className":"OptionsSection_item__bar__Vyym5"}],["$","h3",null,{"className":"OptionsSection_item__title__Z3ctV","children":"Overbooking Compensation"}],["$","p",null,{"className":"OptionsSection_item__desc__kzStL","children":"Did you show up on time for your flight but couldn't board due to lack of available seats? You are entitled to flight compensation."}]]}],["$","div",null,{"className":"OptionsSection_item__ikj3v","children":[["$","div",null,{"className":"OptionsSection_item__bar__Vyym5"}],["$","h3",null,{"className":"OptionsSection_item__title__Z3ctV","children":"Compensation for denied boarding"}],["$","p",null,{"className":"OptionsSection_item__desc__kzStL","children":"Were you denied boarding and given no reason or an insufficient reason? You are entitled to compensation."}]]}],["$","div",null,{"className":"OptionsSection_item__ikj3v","children":[["$","div",null,{"className":"OptionsSection_item__bar__Vyym5"}],["$","h3",null,{"className":"OptionsSection_item__title__Z3ctV","children":"Delayed baggage compensation"}],["$","p",null,{"className":"OptionsSection_item__desc__kzStL","children":"Did your checked baggage arrive late or damaged? You are entitled to compensation."}]]}]]}]]}]}]
4:["$","section",null,{"className":"ServicesOptions_how__f3Uts","aria-labelledby":"how-it-works-title","children":[["$","div",null,{"className":"container ServicesOptions_how__inner__d6EPY","children":[["$","h2",null,{"id":"how-it-works-title","className":"ServicesOptions_how__title__3B19T","children":"How it works"}],["$","ol",null,{"className":"ServicesOptions_how__steps__4Qwvz","children":[["$","li",null,{"className":"ServicesOptions_step__ymZaC","children":[["$","span",null,{"className":"ServicesOptions_step__number__9dfee","aria-hidden":"true","children":"01"}],["$","h3",null,{"className":"ServicesOptions_step__title__Nl8t0","children":"SUBMIT CLAIM"}],["$","p",null,{"className":"ServicesOptions_step__desc__7SW2_","children":"When having problems with your flight all you need to do is fill the compensation claim form on our website, you can even get compensation for up to 6 years prior. From there our experts will do all the necessary paper and routine works and present the complaint to the airline company."}]]}],["$","li",null,{"className":"ServicesOptions_step__ymZaC","children":[["$","span",null,{"className":"ServicesOptions_step__number__9dfee","aria-hidden":"true","children":"02"}],["$","h3",null,{"className":"ServicesOptions_step__title__Nl8t0","children":"SIT BACK AND RELAX"}],["$","p",null,{"className":"ServicesOptions_step__desc__7SW2_","children":"After Flyinspectors engagement you do not have to do anything, except to wait for your flight compensation calmly.\n\nYes, it’s as easy as it sounds!"}]]}],["$","li",null,{"className":"ServicesOptions_step__ymZaC","children":[["$","span",null,{"className":"ServicesOptions_step__number__9dfee","aria-hidden":"true","children":"03"}],["$","h3",null,{"className":"ServicesOptions_step__title__Nl8t0","children":"RECEIVE COMPENSATION"}],["$","p",null,{"className":"ServicesOptions_step__desc__7SW2_","children":"After airlines transfer the compensation, we immediately transfer it to you, with the success fee of 25% deducted. If by any chance we are not successful you pay nothing."}]]}]]}]]}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How it works\",\"inLanguage\":\"en\",\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"SUBMIT CLAIM\",\"text\":\"When having problems with your flight all you need to do is fill the compensation claim form on our website, you can even get compensation for up to 6 years prior. From there our experts will do all the necessary paper and routine works and present the complaint to the airline company.\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"SIT BACK AND RELAX\",\"text\":\"After Flyinspectors engagement you do not have to do anything, except to wait for your flight compensation calmly.\\n\\nYes, it’s as easy as it sounds!\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"RECEIVE COMPENSATION\",\"text\":\"After airlines transfer the compensation, we immediately transfer it to you, with the success fee of 25% deducted. If by any chance we are not successful you pay nothing.\"}]}"}}]]}]
5:["$","section",null,{"className":"WhyWe_why__mycHu","aria-labelledby":"why-title","children":["$","div",null,{"className":"container WhyWe_why__inner__RB3yS","children":[["$","div",null,{"children":[["$","h2",null,{"id":"why-title","className":"WhyWe_why__title__6ENZH","children":"Why Flyinspectors?"}],["$","div",null,{"className":"WhyWe_richText__8VHFd rich-content","dangerouslySetInnerHTML":{"__html":"<p>Most passengers are unaware of their rights when it comes to flight-related issues. Not to mention the resources available to determine if they are entitled to flight compensation. You may need to consult a lawyer to understand the EU regulations and your rights as an air passenger.</p><p>Fortunately, there is an easy solution. Flyinspectors are experts in this field. We can make it easy for you to get your flight compensation. It is completely free for you, we only take a 25% commission if we are successful.</p><p><strong>We have helped many passengers, and we can help you too!</strong></p>"}}]]}],["$","aside",null,{"className":"WhyWe_stat__7Q1gV","children":[["$","p",null,{"className":"WhyWe_stat__number__TfiUD","children":"8 / 10"}],["$","p",null,{"className":"WhyWe_stat__text__2dEUL","children":"passengers who have tried to get compensation on their own say that the airline refused or even didn’t respond."}],["$","hr",null,{"className":"WhyWe_stat__divider__U3Rwl"}],["$","p",null,{"className":"WhyWe_stat__closing__t9v6K","children":"We will make sure that our customers are not treated this way!"}]]}]]}]}]
15:T5d6,{"@context":"https://schema.org","@type":"FAQPage","inLanguage":"en","mainEntity":[{"@type":"Question","name":"In which cases, can I claim compensation","acceptedAnswer":{"@type":"Answer","text":"When struggling with flight-related problem, most of the passengers don’t even know they are eligible for compensation, let alone the resources they need to determine if they qualify for it. You may need legal expertise and a lot of time to get familiar with the flight regulations and your rights as an airline passenger. Fortunately, there is easier solution, Flyinspectors are experts in this field. We can ease the process of getting the flight compensation you may qualify for. And it’s completely free for you, we only take fee of 25% in case of success. Are we not successful, you pay nothing."}},{"@type":"Question","name":"What do I need to receive compensation?","acceptedAnswer":{"@type":"Answer","text":"To start the case is required the copies of the ticket and the passport. We will prepare the following documentation: Declaration of Assignment, POA and Agreement."}},{"@type":"Question","name":"How much am I entitled to be compensated?","acceptedAnswer":{"@type":"Answer","text":"The amount of compensation depends on the distance of your flight between airports: In case of a flight up to 1500 km – 250 Euro In case of flights between 1500 – 3500 km – 400 Euro In case of flights over 3500 km – 600 Euro Delay at the final destination should be more than 3 hours."}}]}6:["$","section",null,{"className":"Faq_faq__eX5TU","aria-labelledby":"faq-title","children":[["$","div",null,{"className":"Faq_faq__inner___192p","children":[["$","h2",null,{"id":"faq-title","className":"Faq_faq__title__Uub9T","children":"Frequently asked questions"}],["$","div",null,{"className":"Faq_faq__list__o49kk","children":[["$","details","6abcb7687e716c6bd089aab5",{"className":"Faq_item__G_IIm","children":[["$","summary",null,{"className":"Faq_item__question__0Eygu","children":[["$","h3",null,{"c