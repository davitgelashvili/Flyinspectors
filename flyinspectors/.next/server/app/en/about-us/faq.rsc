7:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"Frequently Asked Questions — Flyinspectors"}],["$","meta","3",{"name":"description","content":"Answers about our 25% service fee, payout methods, claim timelines and how to check your claim status."}],["$","meta","4",{"name":"facebook-domain-verification","content":"zmft3mvrj1aqht2us3b9a8svelegtx"}],["$","link","5",{"rel":"canonical","href":"https://flyinspectors.ge/en/about-us/faq"}],["$","link","6",{"rel":"alternate","hrefLang":"en","href":"https://flyinspectors.ge/en/about-us/faq"}],["$","link","7",{"rel":"alternate","hrefLang":"ka","href":"https://flyinspectors.ge/ka/about-us/faq"}],["$","link","8",{"rel":"alternate","hrefLang":"x-default","href":"https://flyinspectors.ge/ka/about-us/faq"}],["$","meta","9",{"property":"og:title","content":"Frequently Asked Questions — Flyinspectors"}],["$","meta","10",{"property":"og:description","content":"Answers about our 25% service fee, payout methods, claim timelines and how to check your claim status."}],["$","meta","11",{"property":"og:url","content":"https://flyinspectors.ge/en/about-us/faq"}],["$","meta","12",{"property":"og:site_name","content":"Flyinspectors"}],["$","meta","13",{"property":"og:locale","content":"en_US"}],["$","meta","14",{"property":"og:image","content":"https://res.cloudinary.com/dluqxr8lw/image/upload/v1734813470/meta_en_zr0fxe.jpg"}],["$","meta","15",{"property":"og:type","content":"website"}],["$","meta","16",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","17",{"name":"twitter:title","content":"Frequently Asked Questions — Flyinspectors"}],["$","meta","18",{"name":"twitter:description","content":"Answers about our 25% service fee, payout methods, claim timelines and how to check your claim status."}],["$","meta","19",{"name":"twitter:image","content":"https://res.cloudinary.com/dluqxr8lw/image/upload/v1734813470/meta_en_zr