0:["CmxX21wcJ8XEbSwUi_kMH",[[["",{"children":[["lang","ka","d"],{"children":["about-us",{"children":["blog-page-more-airports",{"children":["__PAGE__?{\"lang\":\"ka\"}",{}]}]}]},"$undefined","$undefined",true]}],["",{"children":[["lang","ka","d"],{"children":["about-us",{"children":["blog-page-more-airports",{"children":["__PAGE__",{},[["$L1",["$L2",["$","div",null,{"children":[["$","div",null,{"className":"AirportList_services__zf_fi","children":["$","div",null,{"className":"container","children":[["$","h3",null,{"className":"AirportList_services__header__QEyHy","children":"Airports that you may never want to leave"}],["$","div",null,{"className":"row","children":["$","div",null,{"className":"AirportList_mainDiv__8kWh1","children":["$","div",null,{"className":"imageDiv column","children":[["$","img",null,{"className":"AirportList_mainDiv__image__XQI4Y","src":"/_next/static/media/Airport-1024x573.c38749df.jpg","alt":"Airplane image with logo"}],["$","p",null,{"className":"AirportList_mainDiv__text__pwQ1E","children":"International air travel is normally a pretty stressful affair. We hustle just to get to the airport. Then we stand through long lines in both security and passport check, pass all necessary stages. These everything may be exhausting. But there are some airports out there that you may never want to leave. These airports were built to impress travelers, not just to shuttle them around the world. Let’s take a look at some of the coolest attractions at airports:"}]]}]}]}]]}]}],["$","div",null,{"className":"Hamad_services__U5wJY","children":["$","div",null,{"className":"container","children":[["$","h3",null,{"className":"Hamad_services__header__lHXJ9","children":["Hamad International Airport (Qatar) — Swimming pool"," "]}],["$","div",null,{"className":"row","children":["$","div",null,{"className":"Hamad_mainDiv__si9cE","children":["$","div",null,{"className":"imageDiv column","children":[["$","img",null,{"className":"Hamad_mainDiv__image__u2WCh","src":"/_next/static/media/Pool-1024x573.a7f345d2.jpg","alt":"Airplane image with logo"}],["$","p",null,{"className":"Hamad_mainDiv__text__zsGcn","children":"Opened in 2014, the Hamad International Airport features a 25 meter, temperature-controlled indoor lap pool. It is open to the public and for only $35 one can take advantage of the pool, gym and Jacuzzi."}]]}]}]}]]}]}],["$","div",null,{"className":"Munich_services__MWTfy","children":["$","div",null,{"className":"container","children":[["$","h3",null,{"className":"Munich_services__header__i3EUg","children":"Munich International Airport (Germany) — Ice rink        "}],["$","div",null,{"className":"row","children":["$","div",null,{"className":"Munich_mainDiv___D0sl","children":["$","div",null,{"className":"imageDiv column","children":[["$","img",null,{"className":"Munich_mainDiv__image__0JxrR","src":"/_next/static/media/Ski-1024x573.43ba0ac0.jpg","alt":"Airplane image with logo"}],["$","p",null,{"className":"Munich_mainDiv__text__l4aLK","children":"There is no other airport in the world that supplies its travelers with both a brewery and giant ice rink. During Christmas the airport holds a winter market where travelers can skate around and then try various brews."}]]}]}]}]]}]}],["$","div",null,{"className":"Incheon_services___wDpg","children":["$","div",null,{"className":"container","children":[["$","h3",null,{"className":"Incheon_services__header__4qM4u","children":["Incheon International Airport (South Korea) — Indoor Garden"," "]}],["$","div",null,{"className":"row","children":["$","div",null,{"className":"Incheon_mainDiv__EVyTl","children":["$","div",null,{"className":"imageDiv column","children":["$","p",null,{"className":"Incheon_mainDiv__text__MgBU5","children":"Since opening in 2001, this has been rated one of the top airports in the world. Incheon International includes fascinating architecture and various gardens sprinkled throughout its terminals."}]}]}]}]]}]}],["$","div",null,{"className":"Malaysia_services__Nzkpe","children":["$","div",null,{"className":"container","children":[["$","h3",null,{"className":"Malaysia_services__header__np0wC","children":"Kuala Lumpur International Airport (Malaysia) — Jungle boardwalk"}],["$","div",null,{"className":"row","children":["$","div",null,{"className":"Malaysia_mainDiv__Oj35s","children":["$","div",null,{"className":"imageDiv column","children":["$","p",null,{"className":"Malaysia_mainDiv__text__3BGxh","children":"One of the world’s busiest airports since it opened in 1998, travelers are often amazed at the Jungle Boardwalk and the palm trees inside the Satellite Terminal gardens, which are encased in circular glass."}]}]}]}]]}]}],["$","div",null,{"className":"Usa_services__0Tyk3","children":["$","div",null,{"className":"container","children":[["$","h3",null,{"className":"Usa_services__header__wEFwx","children":"San Francisco International Airport, International Terminal (U.S.A.) — Yoga Room"}],["$","div",null,{"className":"row","children":["$","div",null,{"className":"Usa_mainDiv__XKbta","children":["$","div",null,{"className":"imageDiv column","children":[["$","img",null,{"className":"Usa_mainDiv__image__WysNd","src":"/_next/static/media/Yoga-1024x573.c2cad773.jpg","alt":"Airplane image with logo"}],["$","p",null,{"className":"Usa_mainDiv__text__j5DPj","children":"San Francisco International Airport’s international terminal features a yoga room to offer its travelers a way to relax after a long overnight flight. There is also the SFO Library and Museum in the International Terminal that has exhibits and books on hand.."}]]}]}]}]]}]}],["$","div",null,{"className":"Spain_services__AR0fM","children":["$","div",null,{"className":"container","children":[["$","h3",null,{"className":"Spain_services__header__rL6Za","children":"Adolfo Suárez Madrid–Barajas Airport (Spain)— Unique architecture"}],["$","div",null,{"className":"row","children":["$","div",null,{"className":"Spain_mainDiv__Z063H","children":["$","div",null,{"className":"imageDiv column","children":["$","p",null,{"className":"Spain_mainDiv__text__OJzLq","children":"One of the two largest airports in Europe based on sheer size, Terminal 4 at Madrid-Barajas is the crown jewel. With angular architecture, flowing dome roofs, circular ceiling windows, and giant cross beams, Terminal 4 is a modern wonder."}]}]}]}]]}]}],["$","div",null,{"className":"China_services__kii93","children":["$","div",null,{"className":"container","children":[["$","h3",null,{"className":"China_services__header__o7PNT","children":"Hong Kong International Airport (Hong Kong SAR, China) — Aviation Museum"}],["$","div",null,{"className":"row","children":["$","div",null,{"className":"China_mainDiv__iPy1w","children":["$","div",null,{"className":"imageDiv column","children":["$","p",null,{"className":"China_mainDiv__text__ihc1q","children":"Where do we begin with the Hong Kong International Airport? There’s an IMAX, virtual golf course, aromatherapy spa, and tons of shops inside. Oh, there’s also a small aviation museum complete with flight simulators called the Aviation Discovery Centre."}]}]}]}]]}]}]]}]],[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/6a5df5389b16dfac.css","precedence":"next","crossOrigin":"$undefined"}]]],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","$4","children","about-us","children","blog-page-more-airports","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","$4","children","about-us","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},